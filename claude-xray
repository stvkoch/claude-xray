        super().__init__()
        self.args = args
        self.session, self.follow, self.paused, self._sig = None, False, False, None
        self.rows = {}   # row key -> payload for the detail dialogs

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        yield Static(id="prompt")
        yield Static(id="ctx")
        yield Static(id="ctxbar")
        with Horizontal(id="mid"):
            with Vertical(classes="box", id="agentsbox"):
                yield DataTable(id="agents", cursor_type="row", zebra_stripes=True)
            with Vertical(classes="box", id="skillsbox"):
                yield DataTable(id="skills", cursor_type="row", zebra_stripes=True)
        with Vertical(classes="box", id="feedbox"):
            yield DataTable(id="feed", cursor_type="row", zebra_stripes=True)
        yield Footer()

    def on_mount(self):
        self.query_one("#agents", DataTable).add_columns("", "descrição", "tipo", "ctx", "tools", "última ferramenta", "skills")
        self.query_one("#skills", DataTable).add_columns("hora", "skill", "como", "quem")
        self.query_one("#feed", DataTable).add_columns("hora", "quem", "ferramenta", "detalhe", "")
        self.query_one("#feedbox").border_title = "Atividade recente · Enter abre detalhes"
        self.query_one("#feed").focus()
        if self.args.session:
            path = resolve_session(self.args.session)
            if not path:
                self.exit(message=f"Sessão {self.args.session} não encontrada.")
                return
            self.open(path)
        elif self.args.latest:
            self.follow = True
            self.open_newest()
        else:
            self.push_screen(Picker(self.args, can_cancel=False), self.picked)
        self.set_interval(self.args.interval, self.tick)

    # ---- session handling ------------------------------------------------
    def picked(self, result):
        if result is None:
            return
        if result == AUTO:
            self.follow = True
            self.open_newest()
        else:
            self.follow = False
            self.open(result)

    def open_newest(self):
        path = newest_session(self.args.all, self.args.cwd)
        if path:
            self.open(path)
        else:
            self.session = None
            self.sub_title = "aguardando uma sessão…"

    def open(self, path):
        self.session = Session(path)
        self.session.update()
        self._sig = None
        self.refresh_view()

    def tick(self):
        if self.paused:
            return
        if self.follow:
            newest = newest_session(self.args.all, self.args.cwd)
            cur = self.session.path if self.session else None
            if newest and newest != cur and (cur is None or born(newest) > born(cur)
                                             or newest.stat().st_mtime > cur.stat().st_mtime + 2):
                self.open(newest)
                self.notify(f"Seguindo nova sessão {newest.stem[:8]}")
                return
        if self.session:
            self.session.update()
            self.refresh_view()

    # ---- actions -----------------------------------------------------------
    def action_pick(self):
        self.push_screen(Picker(self.args, can_cancel=True), self.picked)

    def action_pause(self):
        self.paused = not self.paused
        self.notify("Pausado" if self.paused else "Retomado")

    def action_focus(self, wid):
        self.query_one(f"#{wid}").focus()

    def limit(self):
        return self.args.limit or (1_000_000 if self.session.peak > 200_000 else 200_000)

    def action_context(self):
        if self.session:
            self.push_screen(ContextDetail(self.session, self.limit()))

    def on_click(self, ev):
        if ev.widget is not None and ev.widget.id in ("ctx", "ctxbar"):
            self.action_context()

    def on_data_table_row_selected(self, ev: DataTable.RowSelected):
        payload = self.rows.get(ev.row_key.value)
        if not payload or not self.session:
            return
        kind, data = payload
        title, body = getattr(self, f"detail_{kind}")(data)
        self.push_screen(Detail(title, body))

    # ---- detail builders -----------------------------------------------------
    def detail_feed(self, entry):
        s = self.session
        ts, who, name, short, tid, inp = entry
        parts = [kv(("quando", hhmm(ts)), ("quem", who), ("ferramenta", Text(name, style="bold")),
                    ("resumo", short), ("id", tid or "—")),
                 Rule("entrada", style="dim")]
        if name == "Bash" and inp.get("command"):
            parts.append(code(inp["command"], "bash"))
            rest = {k: v for k, v in inp.items() if k != "command"}
            if rest:
                parts.append(code(json.dumps(rest, indent=2, ensure_ascii=False), "json"))
        else:
            parts.append(code(json.dumps(inp, indent=2, ensure_ascii=False), "json"))
        parts += [Rule("resultado", style="dim"), result_block(s, tid)]
        return f"{name} · {short[:60]}", Group(*parts)

    def detail_skillcall(self, call):
        s = self.session
        ts, who, name, how, tid, args = call
        parts = [kv(("skill", Text(name, style="bold magenta")), ("quando", hhmm(ts)), ("como", how),
                    ("quem", who), ("argumentos", args or "—"))]
        parts += self._skill_info(name)
        if tid:
            parts += [Rule("resultado da chamada", style="dim"), result_block(s, tid)]
        return f"Skill · {name}", Group(*parts)

    def detail_skillname(self, data):
        name, note = data
        return f"Skill · {name}", Group(kv(("skill", Text(name, style="bold magenta")), ("evento", note)),
                                        *self._skill_info(name))

    def _skill_info(self, name):
        s = self.session
        base = name.split(":")[-1]
        reads = s.skill_reads.get(base) or s.skill_reads.get(name)
        out = []
        if reads:
            out.append(kv(("arquivos lidos", ", ".join(sorted(reads)))))
        md = find_skill_md(name, s.cwd or self.args.cwd)
        if md:
            text = md.read_text(errors="replace")
            lines = text.splitlines()
            out += [Rule(str(md).replace(str(Path.home()), "~"), style="dim"),
                    code("\n".join(lines[:150]) + (f"\n\n… (+{len(lines) - 150} linhas)" if len(lines) > 150 else ""),
                         "markdown")]
        else:
            out.append(Text("SKILL.md não encontrado localmente (skill embutida ou de plugin remoto).", style="dim italic"))
        return out

    def detail_agent(self, a):
        s = self.session
        tag = f"agent:{a.id[:6]}"
        steps = [f for f in s.feed if f[1] == tag]
        lines = Text()
        for ts, _, name, short, tid, _ in steps:
            err = s.results.get(tid, (0, 0, False))[2]
            lines.append(f"{hhmm(ts)}  ", style="dim")
            lines.append(f"{name:12}", style="bold red" if err else "bold")
            lines.append(f"{short}\n")
        return f"Agente · {a.desc[:60]}", Group(
            kv(("descrição", a.desc), ("tipo", a.type or "—"), ("modelo", a.model or "—"),
               ("estado", Text("pronto", style="green") if a.finished else Text("rodando", style="yellow")),
               ("contexto", fmt_tok(a.context)), ("ferramentas", a.tools),
               ("skills", ", ".join(dict.fromkeys(a.skills)) or "—"), ("id", a.id)),
            Rule("ferramentas usadas (Enter na Atividade mostra cada uma)", style="dim"),
            lines or Text("nenhuma ainda", style="dim"))

    # ---- drawing -----------------------------------------------------------
    def fill(self, tid, rows):
        """Rebuild a table, keeping the cursor on the same item (or on top if it was there)."""
        t = self.query_one(f"#{tid}", DataTable)
        keep = None
        if t.row_count and t.cursor_row > 0:
            keep = t.coordinate_to_cell_key(t.cursor_coordinate).row_key.value
        t.clear()
        for key, cells, payload in rows:
            self.rows[key] = payload
            t.add_row(*cells, key=key)
        if keep is not None:
            try:
                t.move_cursor(row=t.get_row_index(keep), animate=False)
            except Exception:
                pass

    def refresh_view(self):
        s = self.session
        limit = self.limit()
        mode = "seguindo a mais recente" if self.follow else "sessão fixa"
        self.sub_title = f"{s.id[:8]} · {s.path.parent.name[-40:]} · {mode}" + (" · PAUSADO" if self.paused else "")

        self.query_one("#prompt", Static).update(
            Text.assemble(("último pedido: ", "dim"), s.last_prompt or "—"))
        frac = s.context / limit if limit else 0
        color = "green" if frac < 0.5 else "yellow" if frac < 0.8 else "red"
        self.query_one("#ctx", Static).update(Text.assemble(
            ("Contexto ", "bold"), (f"{fmt_tok(s.context)} / {fmt_tok(limit)} ({frac:.0%})", f"bold {color}"),
            (f"   pico {fmt_tok(s.peak)} · saída total {fmt_tok(s.out_tokens)} · "
             f"compactações {s.compactions} · modelo {s.model or '?'}   ", "dim"), ("[c] detalhes", "dim italic")))
        barw = max(10, self.query_one("#ctxbar").size.width - 2)
        n = int(round(max(0.0, min(1.0, frac)) * barw))
        self.query_one("#ctxbar", Static).update(
            Text.assemble(("█" * n, color), ("░" * (barw - n), "grey37")))

        running = [a for a in s.agents.values() if not a.finished]
        done = [a for a in s.agents.values() if a.finished]
        self.query_one("#agentsbox").border_title = (
            f"[1] Agentes · chamados {s.agent_calls} · rodando {len(running)} · terminados {len(done)}")
        self.query_one("#skillsbox").border_title = (
            f"[2] Skills · disponíveis {s.skills_available} · invocadas {len(s.skill_calls)}"
            + (f" · novas {len(s.skills_added)}" if s.skills_added else ""))
        self.query_one("#feedbox").border_title = "[3] Atividade recente · Enter abre detalhes"

        sig = (s.id, s.agent_calls, tuple((a.id, a.finished, a.tools, a.context, a.desc) for a in s.agents.values()),
               len(s.skill_calls), len(s.skills_added), sum(map(len, s.skill_reads.values())),
               len(s.feed), s.feed[-1][:5] if s.feed else None, len(s.results))
        if sig == self._sig:
            return
        self._sig = sig
        self.rows = {}

        show = sorted(running, key=lambda a: a.start, reverse=True) + sorted(done, key=lambda a: a.start, reverse=True)
        self.fill("agents", [
            (f"ag:{a.id}",
             (Text("● rodando", style="bold yellow") if not a.finished else Text("✓ pronto", style="green"),
              Text(a.desc[:40]), Text(a.type, style="dim"), fmt_tok(a.context), str(a.tools),
              Text(a.last_tool[:40], style="dim"), Text(",".join(dict.fromkeys(a.skills)), style="magenta")),
             ("agent", a)) for a in show])

        rows = []
        for i, call in reversed(list(enumerate(s.skill_calls))):
            ts, who, name, how = call[:4]
            rows.append((f"sc:{i}", (hhmm(ts), Text(name, style="magenta"), Text(how, style="dim"), Text(who, style="dim")),
                         ("skillcall", call)))
        for i, (ts, name) in reversed(list(enumerate(s.skills_added))):
            rows.append((f"sa:{i}", (hhmm(ts), Text("+ " + name, style="cyan"), Text("adicionada", style="dim"), ""),
                         ("skillname", (name, f"adicionada à lista às {hhmm(ts)}"))))
        for k, v in s.skill_reads.items():
            rows.append((f"sr:{k}", ("", Text(k, style="magenta"), Text("leu " + ", ".join(sorted(v)), style="dim"), ""),
                         ("skillname", (k, "arquivos da skill lidos"))))
        self.fill("skills", rows)

        rows = []
        for i, entry in enumerate(sorted(s.feed, key=lambda x: x[0], reverse=True)[:200]):
            ts, who, name, detail, tid, _ = entry
            res = s.results.get(tid)
            st = Text("…", style="yellow") if res is None else Text("✗", style="bold red") if res[2] else Text("✓", style="green")
            rows.append((f"fd:{tid or ts + name + str(i)}",
                         (hhmm(ts), Text(who, style="dim" if who == "main" else "cyan"), Text(name, style="bold"),
                          Text(detail[:120]), st), ("feed", entry)))
        self.fill("feed", rows)


def main():
    ap = argparse.ArgumentParser(description="Live X-ray of a Claude Code session.")
    ap.add_argument("--session", help="session id (or path to the .jsonl)")
    ap.add_argument("--all", action="store_true", help="list/follow sessions of every project")
    ap.add_argument("--cwd", default=os.getcwd(), help="project directory (default: current directory)")
    ap.add_argument("--limit", type=int, default=0, help="context window for the %% bar (default: auto, 200k or 1M)")
    ap.add_argument("--interval", type=float, default=1.0)
    ap.add_argument("--once", action="store_true", help="print one plain-text snapshot and exit")
    ap.add_argument("--latest", "-l", action="store_true", help="skip the menu and follow the newest session")
    ap.add_argument("--list", type=int, default=15, help="how many sessions the menu shows (default 15)")
    args = ap.parse_args()

    if args.once or not sys.stdout.isatty():
        path = resolve_session(args.session) if args.session else newest_session(args.all, args.cwd)
        if not path:
            sys.exit("Nenhuma sessão encontrada. Use --all ou --session ID.")
        s = Session(path)
        s.update()
        print(render(s, args.limit))
        return
    XRay(args).run()


if __name__ == "__main__":
    main()
